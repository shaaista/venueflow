// VenueFlow — Multi-tenant Venue & Event Enquiry CRM
// Prisma schema. Every tenant-scoped model carries `organizationId` for data isolation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum OrgStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  CANCELLED
}

enum Role {
  SUPER_ADMIN
  OWNER
  ADMIN
  MANAGER
  COORDINATOR
  STAFF
  VIEWER
  CUSTOMER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum PlanTier {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  INCOMPLETE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  DEPOSIT_PAID
  CONFIRMED
  COMPLETED
  LOST
}

enum LeadTemperature {
  HOT
  WARM
  COLD
}

enum CustomerStatus {
  VIP
  ACTIVE
  PROSPECT
  INACTIVE
}

enum EventStatus {
  INQUIRY
  PROPOSAL_SENT
  AWAITING_DEPOSIT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  TENTATIVE
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum SpaceAvailability {
  HIGH
  LIMITED
  BOOKED
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  CASH
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum Channel {
  EMAIL
  SMS
  WHATSAPP
  INTERNAL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum AutomationTrigger {
  NEW_ENQUIRY
  LEAD_CREATED
  EVENT_CONFIRMED
  DEPOSIT_PAID
  PAYMENT_FAILED
  EVENT_COMPLETED
  CUSTOMER_INACTIVE
  BIRTHDAY
  QUOTE_VIEWED
  INVOICE_OVERDUE
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
}

enum NotificationType {
  ENQUIRY
  PAYMENT
  QUOTE
  EVENT
  MESSAGE
  TASK
  SYSTEM
}

// ─────────────────────────── Tenancy ───────────────────────────

model Organization {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  domain       String?    @unique
  logoUrl      String?
  brandColor   String     @default("#4A3728")
  status       OrgStatus  @default(TRIAL)
  settings     Json       @default("{}")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  memberships    Membership[]
  invitations    Invitation[]
  subscription   Subscription?
  featureFlags   OrgFeatureFlag[]
  leads          Lead[]
  customers      Customer[]
  venues         Venue[]
  spaces         Space[]
  events         Event[]
  bookings       Booking[]
  quotes         Quote[]
  invoices       Invoice[]
  payments       Payment[]
  tasks          Task[]
  conversations  Conversation[]
  messageTemplates MessageTemplate[]
  files          FileObject[]
  folders        Folder[]
  forms          Form[]
  automations    Automation[]
  campaigns      Campaign[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  apiKeys        ApiKey[]
  webhooks       Webhook[]

  @@index([status])
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?
  name            String
  avatarUrl       String?
  phone           String?
  isSuperAdmin    Boolean   @default(false)
  emailVerified   Boolean   @default(false)
  emailVerifyToken String?
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret String?
  googleId        String?   @unique
  resetToken      String?
  resetTokenExp   DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  memberships     Membership[]
  sessions        Session[]
  invitationsSent Invitation[]    @relation("InvitedBy")
  assignedLeads   Lead[]          @relation("LeadOwner")
  assignedEvents  Event[]         @relation("EventCoordinator")
  assignedTasks   Task[]          @relation("TaskAssignee")
  notifications   Notification[]
  auditLogs       AuditLog[]
  uploadedFiles   FileObject[]
  taskComments    TaskComment[]
  notes           Note[]
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           Role             @default(STAFF)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ip           String?
  device       String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           Role             @default(STAFF)
  token          String           @unique
  invitedById    String?
  status         MembershipStatus @default(INVITED)
  expiresAt      DateTime
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([email])
}

// ─────────────────────── Billing / Platform ───────────────────────

model Plan {
  id          String   @id @default(cuid())
  tier        PlanTier @unique
  name        String
  priceMonthly Int
  maxUsers    Int
  maxEvents   Int
  features    Json     @default("[]")
  createdAt   DateTime @default(now())

  subscriptions Subscription[]
}

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  planId               String
  status               SubscriptionStatus @default(TRIALING)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])
}

model FeatureFlag {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  enabled     Boolean @default(false)
  rolloutPct  Int     @default(0)
  createdAt   DateTime @default(now())

  overrides OrgFeatureFlag[]
}

model OrgFeatureFlag {
  id             String  @id @default(cuid())
  organizationId String
  flagId         String
  enabled        Boolean

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  flag         FeatureFlag  @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@unique([organizationId, flagId])
}

// ───────────────────────────── CRM ─────────────────────────────

model Lead {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  contactName    String
  email          String
  phone          String?
  company        String?
  location       String?
  source         String?
  status         LeadStatus      @default(NEW)
  temperature    LeadTemperature @default(WARM)
  eventType      String?
  eventDate      DateTime?
  guests         Int?
  value          Decimal         @default(0) @db.Decimal(12, 2)
  notes          String?
  tags           String[]        @default([])
  assignedToId   String?
  customerId     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("LeadOwner", fields: [assignedToId], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])
  activities   Activity[]
  notesRel     Note[]

  @@index([organizationId, status])
  @@index([organizationId, assignedToId])
}

model Customer {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  company        String?
  email          String
  phone          String?
  location       String?
  status         CustomerStatus @default(ACTIVE)
  tags           String[]       @default([])
  lifetimeValue  Decimal        @default(0) @db.Decimal(12, 2)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts      Contact[]
  leads         Lead[]
  events        Event[]
  quotes        Quote[]
  invoices      Invoice[]
  conversations Conversation[]
  notesRel      Note[]

  @@index([organizationId, status])
}

model Contact {
  id         String   @id @default(cuid())
  customerId String
  name       String
  email      String?
  phone      String?
  role       String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Venue {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  address        String?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  spaces       Space[]

  @@index([organizationId])
}

model Space {
  id             String            @id @default(cuid())
  organizationId String
  venueId        String
  name           String
  slug           String
  tagline        String?
  capacity       Int
  size           String?
  priceFrom      Decimal           @default(0) @db.Decimal(12, 2)
  amenities      String[]          @default([])
  imageUrl       String?
  availability   SpaceAvailability @default(HIGH)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  venue        Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  events       Event[]
  blackouts    BlackoutDate[]

  @@index([organizationId])
  @@index([venueId])
}

model BlackoutDate {
  id        String   @id @default(cuid())
  spaceId   String
  date      DateTime
  reason    String?
  type      String   @default("blackout") // blackout | maintenance

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, date])
}

model Event {
  id             String      @id @default(cuid())
  organizationId String
  title          String
  type           String?
  customerId     String?
  spaceId        String?
  date           DateTime
  startTime      String?
  endTime        String?
  guests         Int         @default(0)
  budget         Decimal     @default(0) @db.Decimal(12, 2)
  value          Decimal     @default(0) @db.Decimal(12, 2)
  paid           Decimal     @default(0) @db.Decimal(12, 2)
  status         EventStatus @default(INQUIRY)
  coordinatorId  String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id])
  space        Space?       @relation(fields: [spaceId], references: [id])
  coordinator  User?        @relation("EventCoordinator", fields: [coordinatorId], references: [id])
  bookings     Booking[]
  quotes       Quote[]
  invoices     Invoice[]
  tasks        Task[]
  checklist    ChecklistItem[]
  scheduleItems ScheduleItem[]
  guestList    Guest[]

  @@index([organizationId, status])
  @@index([organizationId, date])
}

model ChecklistItem {
  id      String  @id @default(cuid())
  eventId String
  label   String
  done    Boolean @default(false)
  order   Int     @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model ScheduleItem {
  id      String @id @default(cuid())
  eventId String
  time    String
  title   String
  note    String?
  order   Int    @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Guest {
  id      String  @id @default(cuid())
  eventId String
  name    String
  role    String?
  rsvp    String  @default("Pending")
  meal    String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Booking {
  id             String        @id @default(cuid())
  organizationId String
  eventId        String?
  spaceId        String
  start          DateTime
  end            DateTime
  status         BookingStatus @default(TENTATIVE)
  deposit        Decimal       @default(0) @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id])
  space        Space        @relation(fields: [spaceId], references: [id])

  @@index([organizationId])
  @@index([spaceId, start, end])
}

// ─────────────────────── Quotes / Invoices ───────────────────────

model Quote {
  id             String      @id @default(cuid())
  organizationId String
  number         String
  customerId     String?
  eventId        String?
  status         QuoteStatus @default(DRAFT)
  subtotal       Decimal     @default(0) @db.Decimal(12, 2)
  discount       Decimal     @default(0) @db.Decimal(12, 2)
  taxRate        Decimal     @default(0) @db.Decimal(5, 2)
  total          Decimal     @default(0) @db.Decimal(12, 2)
  notes          String?
  validUntil     DateTime?
  sentAt         DateTime?
  viewedAt       DateTime?
  acceptedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?       @relation(fields: [customerId], references: [id])
  event        Event?          @relation(fields: [eventId], references: [id])
  lineItems    QuoteLineItem[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

model QuoteLineItem {
  id       String  @id @default(cuid())
  quoteId  String
  label    String
  detail   String?
  quantity Int     @default(1)
  unit     Decimal @default(0) @db.Decimal(12, 2)
  order    Int     @default(0)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  number         String
  customerId     String?
  eventId        String?
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  taxRate        Decimal       @default(0) @db.Decimal(5, 2)
  total          Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  issuedAt       DateTime?
  dueAt          DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?         @relation(fields: [customerId], references: [id])
  event        Event?            @relation(fields: [eventId], references: [id])
  lineItems    InvoiceLineItem[]
  payments     Payment[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

model InvoiceLineItem {
  id        String  @id @default(cuid())
  invoiceId String
  label     String
  detail    String?
  quantity  Int     @default(1)
  unit      Decimal @default(0) @db.Decimal(12, 2)
  order     Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id                    String        @id @default(cuid())
  organizationId        String
  invoiceId             String?
  amount                Decimal       @db.Decimal(12, 2)
  method                PaymentMethod @default(CARD)
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?
  reference             String?
  refundedAmount        Decimal       @default(0) @db.Decimal(12, 2)
  paidAt                DateTime?
  createdAt             DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id])

  @@index([organizationId, status])
}

// ─────────────────────── Tasks / Activity ───────────────────────

model Task {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueAt          DateTime?
  eventId        String?
  assignedToId   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?        @relation(fields: [eventId], references: [id])
  assignedTo   User?         @relation("TaskAssignee", fields: [assignedToId], references: [id])
  comments     TaskComment[]

  @@index([organizationId, status])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id])

  @@index([taskId])
}

// Polymorphic-ish activity + notes attached to leads/customers/events
model Activity {
  id        String   @id @default(cuid())
  leadId    String?
  kind      String   // note | email | call | stage | quote | visit
  title     String
  body      String?
  actor     String?
  createdAt DateTime @default(now())

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model Note {
  id         String   @id @default(cuid())
  authorId   String?
  body       String
  leadId     String?
  customerId String?
  createdAt  DateTime @default(now())

  author   User?     @relation(fields: [authorId], references: [id])
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// ─────────────────────── Messaging / Files ───────────────────────

model Conversation {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String?
  channel        Channel  @default(EMAIL)
  subject        String?
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id])
  messages     Message[]

  @@index([organizationId])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  direction      MessageDirection
  channel        Channel          @default(EMAIL)
  body           String
  fromName       String?
  scheduledAt    DateTime?
  sentAt         DateTime?
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model MessageTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  channel        Channel  @default(EMAIL)
  subject        String?
  body           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Folder {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  parentId       String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  files        FileObject[]

  @@index([organizationId])
}

model FileObject {
  id             String   @id @default(cuid())
  organizationId String
  folderId       String?
  name           String
  url            String
  mimeType       String?
  size           Int      @default(0)
  uploadedById   String?
  createdAt      DateTime @default(now())
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folder       Folder?      @relation(fields: [folderId], references: [id])
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id])

  @@index([organizationId])
}

// ─────────────────────── Forms / Automations ───────────────────────

model Form {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  schema         Json     @default("{}")
  isPublic       Boolean  @default(true)
  submissionsCount Int    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submissions  FormSubmission[]

  @@index([organizationId])
}

model FormSubmission {
  id        String   @id @default(cuid())
  formId    String
  data      Json
  createdAt DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
}

model Automation {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  trigger        AutomationTrigger
  actions        Json              @default("[]")
  enabled        Boolean           @default(true)
  runCount       Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         AutomationRun[]

  @@index([organizationId, trigger])
}

model AutomationRun {
  id           String   @id @default(cuid())
  automationId String
  status       String   @default("success")
  context      Json?
  createdAt    DateTime @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
}

model Campaign {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  subject        String?
  body           String?
  audience       Json           @default("{}")
  status         CampaignStatus @default(DRAFT)
  scheduledAt    DateTime?
  sentCount      Int            @default(0)
  openRate       Float          @default(0)
  clickRate      Float          @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ─────────────────────── Notifications / Audit ───────────────────────

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  type           NotificationType @default(SYSTEM)
  title          String
  body           String?
  link           String?
  read           Boolean          @default(false)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorId        String?
  action         String
  entity         String?
  entityId       String?
  meta           Json?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  prefix         String
  hashedKey      String
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Webhook {
  id             String   @id @default(cuid())
  organizationId String
  url            String
  events         String[] @default([])
  secret         String
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}
